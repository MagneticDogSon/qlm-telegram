{
  "name": "qlm-telegram",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c cyan,magenta \"tsx watch src/server.ts --dev-ui\" \"vite --port=3000 --host ::\"",
    "start": "tsx src/server.ts",
    "build": "vite build",
    "build:pages": "vite build --base=/qlm-telegram/",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-qlm.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "grammy": "^1.35.0",
    "https-proxy-agent": "^9.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "multer": "^2.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "telegram": "^2.26.22",
    "undici": "^8.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
